# Supabase project URL + anon key. These two also power sign-up/sign-in:
# authentication is Supabase Auth, so there is no separate auth secret to set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=anthropic/claude-sonnet-4.5
# Direct Postgres connection string, used ONLY by `scripts/apply-migration.mjs`
# to apply a migration file from your machine. Supabase dashboard ->
# Settings -> Database -> Connection string -> URI. Not read by the app itself.
SUPABASE_DB_URL=

# --- Supabase Edge Function secrets, NOT Next.js env vars ---
# `supabase/functions/daily-digest/agentmail.ts` and `index.ts` read these
# via `Deno.env.get(...)` inside the deployed Edge Function, which does NOT
# read `.env.local` (that's this app's Next.js runtime only). Set these on
# the Supabase project instead, once per deployment:
#   supabase secrets set AGENTMAIL_API_KEY=... DIGEST_RECIPIENT_EMAIL=...
#
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
# DIGEST_RECIPIENT_EMAIL=
