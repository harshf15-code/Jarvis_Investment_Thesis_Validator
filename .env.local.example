NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=anthropic/claude-sonnet-4.5
# Single shared password gating the whole app (no user accounts). Compared
# against the login form's submitted value with a constant-time comparison.
APP_PASSWORD=
# HMAC signing secret for session JWTs (jose SignJWT/jwtVerify, HS256). Use a
# long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
