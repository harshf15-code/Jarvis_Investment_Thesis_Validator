NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Base URL server components use to call this app's own API routes
# server-side (e.g. `app/(app)/positions/page.tsx` fetching
# `GET /api/positions`). Every later server-component page in this plan
# that calls its own API route server-side reuses this same pattern.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=anthropic/claude-sonnet-4.5
# Single shared password gating the whole app (no user accounts). Compared
# against the login form's submitted value with a constant-time comparison.
APP_PASSWORD=
# HMAC signing secret for session JWTs (jose SignJWT/jwtVerify, HS256). Use a
# long random string, e.g. `openssl rand -base64 32`.
SESSION_SECRET=

# --- Supabase Edge Function secrets, NOT Next.js env vars ---
# `supabase/functions/daily-digest/agentmail.ts` and `index.ts` read these
# via `Deno.env.get(...)` inside the deployed Edge Function, which does NOT
# read `.env.local` (that's this app's Next.js runtime only). Set these on
# the Supabase project instead, once per deployment:
#   supabase secrets set AGENTMAIL_API_KEY=... DIGEST_RECIPIENT_EMAIL=...
#
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX_ID=
# DIGEST_RECIPIENT_EMAIL=
