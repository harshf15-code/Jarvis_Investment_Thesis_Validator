{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    // Deno Edge Functions (Task 11): a separate deployable/runtime with its
    // own globals (`Deno.*`), URL-specifier imports (`https://esm.sh/...`),
    // and `.ts`-extension relative imports — none of which are valid under
    // this project's Node/bundler `moduleResolution`. Not part of the
    // Next.js build; type-checked only by eye and via the pure logic
    // extracted into `lib/trigger-logic.ts` (see that file's and
    // `supabase/functions/poll-prices/index.ts`'s comments).
    "supabase/functions/**"
  ]
}
